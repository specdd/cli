Spec: Shared Constants
Purpose:
  Provide shared values for SpecDD paths, release metadata, URLs, version parsing, and common CLI text.

Structure:
  ./constants.ts: Shared constants implementation.

Owns:
  ./constants.ts

Can modify:
  ./constants.ts

Must:
  Provide constants for SpecDD bootstrap paths, release metadata, distribution assets, URLs, and common CLI text.
  Provide constants for Agent Skills release metadata, asset names, install paths, and skill prefixes.
  Provide constants for SpecDD version parsing and front matter parsing.
  Provide constants for the plugin registry path, managed plugin directory, source plugin directory, plugin filename, project lock path, GitHub shorthand host, and default registry version.
  Provide the plugin detached signature filename and default-No continuation prompt.
  Provide the official SpecDD GitHub organization name.
  Keep values static and free of runtime side effects.

Must not:
  Read environment variables.
  Perform filesystem or network operations.

Exposes:
  @SPECDD_DIRECTORY_PATH
  @SPECDD_BOOTSTRAP_FILE_NAME
  @SPECDD_LOCAL_BOOTSTRAP_FILE_NAME
  @SPECDD_GITIGNORE_FILE_NAME
  @SPECDD_BOOTSTRAP_PATH
  @SPECDD_GITIGNORE_PATH
  @SPECDD_LOCAL_BOOTSTRAP_GITIGNORE_CONTENT
  @SPECDD_HOMEPAGE_URL
  @SPECDD_CHANGELOG_URL
  @SPECDD_CLI_HELP_URL
  @SPECDD_GITHUB_RELEASE_BASE_URL
  @SPECDD_DISTRIBUTION_ASSET_NAME
  @SPECDD_SIGNATURE_ASSET_NAME
  @AGENTSKILLS_GITHUB_RELEASE_BASE_URL
  @AGENTSKILLS_RELEASE_ASSET_NAME
  @AGENTSKILLS_SIGNATURE_ASSET_NAME
  @AGENTSKILLS_DIRECTORY_PATH
  @AGENTSKILLS_SKILLS_DIRECTORY_PATH
  @AGENTSKILLS_SKILL_PREFIX
  @SPECDD_COPYRIGHT_NOTICE
  @CLI_HELP_FOOTER
  @SPECDD_VERSION_PATTERN
  @SPECDD_LEADING_V_VERSION_PATTERN
  @SPECDD_VERSION_PART_SEPARATOR
  @SPECDD_FRONT_MATTER_DELIMITER
  @PLUGIN_REGISTRY_PATH
  @PLUGIN_DIRECTORY_PATH
  @PLUGIN_SOURCE_DIRECTORY_PATH
  @PLUGIN_FILE_NAME
  @PLUGIN_LOCK_PATH
  @PLUGIN_GITHUB_HOST
  @SPECDD_GITHUB_ORGANIZATION
  @PLUGIN_DEFAULT_VERSION
  @PLUGIN_SIGNATURE_FILE_NAME
  @CLI_CONTINUE_PROMPT
